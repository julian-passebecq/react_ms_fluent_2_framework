{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conceptmotion.dev/schemas/lineage.schema.json",
  "title": "ConceptMotion Lineage Spec",
  "type": "object",
  "required": ["kind", "assets", "flows"],
  "properties": {
    "kind": { "const": "lineage" },
    "version": { "type": "string" },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "layout": { "type": "string" },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
    "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "layer": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "flow": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "operation": { "type": "string" },
        "animated": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
