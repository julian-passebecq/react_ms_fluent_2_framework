{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:datapass:schema:diagram:1",
  "title": "Datapass semantic Diagram",
  "description": "Editor structural assistance. Run pnpm validate:specs for authoritative runtime/semantic validation. Unknown extension fields remain allowed.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "diagram"
    },
    "version": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "\\S"
    },
    "title": {
      "$ref": "#/definitions/localizedText"
    },
    "description": {
      "$ref": "#/definitions/localizedText"
    },
    "layout": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "layered",
            "radial"
          ]
        },
        "hubId": {
          "type": "string",
          "pattern": "\\S"
        },
        "direction": {
          "enum": [
            "lr",
            "rl",
            "tb",
            "bt"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "comfortable"
          ]
        },
        "preferredRanks": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "align": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "label": {
            "$ref": "#/definitions/localizedText"
          },
          "groupId": {
            "type": "string",
            "pattern": "\\S"
          },
          "preferredRank": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "description": "Semantic node category; use a string from the production semantic icon/category registry."
          },
          "iconId": {
            "description": "Semantic icon registry ID; never a vendor asset URL."
          },
          "metadata": {
            "description": "Optional JSON metadata; not a layout-coordinate contract."
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "label": {
                  "$ref": "#/definitions/localizedText"
                },
                "side": {
                  "enum": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                  ]
                },
                "role": {
                  "description": "Optional semantic port role."
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "from": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "\\S"
              },
              "portId": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "nodeId"
            ],
            "additionalProperties": true
          },
          "to": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "\\S"
              },
              "portId": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "nodeId"
            ],
            "additionalProperties": true
          },
          "label": {
            "$ref": "#/definitions/localizedText"
          },
          "flowKind": {
            "enum": [
              "data",
              "data-batch",
              "data-stream",
              "cdc",
              "control",
              "dependency",
              "lineage",
              "success",
              "failure",
              "completion",
              "skip"
            ]
          },
          "metadata": {
            "description": "Optional edge metadata."
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": true
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "label": {
            "$ref": "#/definitions/localizedText"
          },
          "parentId": {
            "type": "string",
            "pattern": "\\S"
          },
          "childNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "childGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "kind": {
            "description": "Optional semantic group category."
          },
          "metadata": {
            "description": "Optional group metadata."
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "kind",
    "version",
    "id",
    "title",
    "nodes",
    "edges"
  ],
  "additionalProperties": true,
  "definitions": {
    "localizedText": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            },
            "no": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "en"
              ],
              "properties": {
                "en": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            {
              "required": [
                "no"
              ],
              "properties": {
                "no": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
