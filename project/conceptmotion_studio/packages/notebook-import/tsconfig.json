{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.cache/notebook-import.tsbuildinfo",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
