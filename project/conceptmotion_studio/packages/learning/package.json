{
  "name": "@datapass/learning",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "test": "vitest run tests --environment jsdom",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@datapass/code": "workspace:*",
    "@datapass/content": "workspace:*",
    "@datapass/figure": "workspace:*",
    "@datapass/progress": "workspace:*"
  },
  "peerDependencies": {
    "@fluentui/react-components": ">=9.0.0 <10.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
