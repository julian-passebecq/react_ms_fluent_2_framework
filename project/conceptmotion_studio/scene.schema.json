{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConceptMotion Scene v1",
  "description": "Canonical AI-authored scene shape. Renderer-specific static payload belongs under data; frame fields describe semantic state over time.",
  "type": "object",
  "required": [
    "id",
    "title",
    "renderer",
    "data",
    "code",
    "frames"
  ],
  "properties": {
    "version": {
      "type": [
        "string",
        "number"
      ],
      "default": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "code": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "caption",
          "operation"
        ],
        "properties": {
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string"
          },
          "codeFocus": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "duration": {
            "type": "number",
            "minimum": 0
          },
          "hold": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
